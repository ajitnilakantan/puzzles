# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

[*.fs]
max_line_length = 160
fsharp_max_if_then_short_width = 80
fsharp_max_if_then_else_short_width = 80
fsharp_max_array_or_list_width = 120

# Example: Disable FSAC0004 (Parentheses can be removed)
dotnet_diagnostic.FS0004.severity = none
dotnet_diagnostic.FSAC0004.severity = none
dotnet_diagnostic.0004.severity = none
