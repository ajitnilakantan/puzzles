<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Add FSAC0004 (or 0004) to the list of suppressed warnings -->
    <NoWarn>$(NoWarn);FSAC0004;</NoWarn>
  </PropertyGroup>

  <!-- Automatically upgrade to .NET 10 if the .NET 10 SDK is installed -->
  <PropertyGroup Condition="$(NETCoreSdkVersion.StartsWith('10.'))">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Automatically upgrade to future versions (e.g., .NET 11+) -->
  <PropertyGroup Condition="$([System.Version]::Parse($(NETCoreSdkVersion)).Major) &gt; 10">
    <TargetFramework>net$( [System.Version]::Parse($(NETCoreSdkVersion)).Major ).0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aoc2023\aoc2023.fsproj" />
  </ItemGroup>

</Project>
