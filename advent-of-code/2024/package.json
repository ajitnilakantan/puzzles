{
  "name": "aoc-skeleton",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts --target=bun",
    "build": "bun build src/main.ts --target=bun",
    "test": "bun test",
    "lint": "bunx eslint . --ext .ts,.mts,.js,.mjs",
    "lint:fix": "bunx eslint . --fix",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "syntax": "bunx  tsc --noEmit",
    "validate": "bun run format && bun run lint",
    "clean": "bun prune --production; bun pm cache rm"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/lodash": "^4.17.25",
    "bun-types": "^1.4.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "z3-solver": "^5.2.0"
  }
}
